# A user unit, not a system one. review-mate reads your git credentials, writes under your $HOME,
# and exists to be talked to by clients running as you — all of which a system service would have to
# be given back one awkward piece at a time.
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/systemd/review-mate.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now review-mate
#
# Deliberately *not* here: your API token. See the README — a token set in this file is frozen for
# the life of the process and shows up in `systemctl show` and the journal, whereas one left to
# `glab` or `gh` is re-read when the old one is refused, so `glab auth login` / `gh auth login`
# takes effect on the running server with no restart.

[Unit]
Description=review-mate — a local code-review companion
Documentation=https://github.com/Joacchim/review-mate-prototype
After=network-online.target graphical-session.target

[Service]
Type=exec

# Wait for a credential to become obtainable before starting — never for longer than it takes.
#
# `glab` and `gh` keep their tokens in the OS keyring, which your login session unlocks. With
# linger enabled this manager starts at boot, before there is a session, and review-mate resolves
# credentials *once*, at startup: come up two seconds early and it has no forge for the life of
# the process, showing an empty queue rather than an error. Ordering after graphical-session.target
# covers the login case and does nothing under linger, where that target is never reached.
#
# The wait is bounded and its failure ignored, because having no forge is a supported state, not
# an error: with no credentials at all the server still runs, and a branch on this machine needs
# git and nothing else. Installations that authenticate by environment instead skip the wait
# entirely — with neither CLI present there is nothing to wait for.
ExecStartPre=-/bin/sh -c 'command -v gh >/dev/null 2>&1 || command -v glab >/dev/null 2>&1 || exit 0; timeout 120 sh -c "until gh auth token >/dev/null 2>&1 || glab auth status >/dev/null 2>&1; do sleep 2; done"'
TimeoutStartSec=180

ExecStart=%h/.local/bin/review-mate
Restart=on-failure
RestartSec=2s

# Reviews are event-sourced under ~/.review-mate and restored at startup, so a restart keeps them.
# What a restart does drop is the in-flight notification stream, which is designed to be re-derived
# from that durable state rather than replayed — see docs/architecture.md.

# Cloning uses whatever git credentials you already have. Over ssh that means an agent, and a user
# unit does not inherit one from your login session — `echo $SSH_AUTH_SOCK` in a terminal prints
# the one you are using. Uncomment whichever line matches, or leave all of them and accept reviews
# over the host API alone.
#
# Without it, everything read from the repository rather than from the forge stops: the diff view
# mode that compares against your last review, the marks on code a later commit rewrites, and the
# checkout an agent greps. The forge half keeps working, which is what makes the failure confusing
# — the merge request loads and only some of the screen is missing.
#Environment=SSH_AUTH_SOCK=%t/gnupg/S.gpg-agent.ssh
#Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
#Environment=SSH_AUTH_SOCK=%t/keyring/ssh

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
